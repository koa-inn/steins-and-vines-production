{
  "name": "steins-vines-zoho-middleware",
  "version": "1.0.1",
  "description": "Express middleware bridging Steins & Vines frontend to Zoho Books API",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint routes/ lib/ server.js --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db": "jest --config jest.db.config.js",
    "migrate": "node scripts/migration-guard.js && node-pg-migrate up",
    "migrate:guard": "node scripts/migration-guard.js",
    "backfill": "node scripts/backfill/backfill.js"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "eslint": "^9.39.4",
    "exceljs": "4.4.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "12.0.4"
  },
  "dependencies": {
    "@sentry/node": "^10.42.0",
    "axios": "^1.13.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "globalpayments-api": "^3.10.10",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "redis": "^5.10.0"
  }
}
